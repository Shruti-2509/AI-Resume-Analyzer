<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>AI Resume Analyzer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #e3f2fd;
        }

        .navbar {
            background: linear-gradient(90deg,#0288d1,#03a9f4);
        }

        .card {
            border-radius: 16px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
        }

        .btn-primary {
            background: #0288d1;
            border: none;
        }

        .btn-primary:hover {
            background: #0277bd;
        }

        .brand {
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .footer {
            font-size: 12px;
            color: #555;
        }

        /* ✅ Chatbox Styling */
        #chatbox {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        #chatContent div {
            margin-bottom: 5px;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark">
        <div class="container">
            <span class="navbar-brand brand">AI Resume Analyzer</span>
            <div>
                @if (Context.Session.GetString("name") != null)
                {
                    <span class="text-white me-3">Hi, @Context.Session.GetString("name")</span>
                    <a href="/Account/Logout" class="btn btn-light btn-sm">Logout</a>
                }
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <div class="text-center mt-4 footer">
        © Resume Analyzer Project
    </div>

    <!-- ✅ CHATBOT UI -->
    <div id="chatbox" style="position:fixed; bottom:20px; right:20px; width:300px; background:white;">
        <div style="background:#0d6efd; color:white; padding:10px; text-align:center;">
            AI Chatbot
        </div>

        <div id="chatContent" style="height:200px; overflow:auto; padding:10px;">
        </div>

        <input type="text" id="msg" placeholder="Ask something..." class="form-control" />

        <button onclick="sendMsg()" class="btn btn-primary w-100">
            Send
        </button>
    </div>

    <!-- ✅ CHATBOT SCRIPT -->
    <script>
        function sendMsg() {
            var msg = document.getElementById("msg").value;

            fetch('/Home/Chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'message=' + msg
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById("chatContent").innerHTML +=
                    "<div><b>You:</b> " + msg + "</div>" +
                    "<div><b>Bot:</b> " + data + "</div>";

                document.getElementById("msg").value = "";
            });
        }
    </script>

</body>
</html>