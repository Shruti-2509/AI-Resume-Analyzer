@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="height:70vh;">
    <div class="card p-4 shadow" style="width:450px; border-radius:15px;">

        <h3 class="text-center mb-3">Upload Resume</h3>

        <form method="post" enctype="multipart/form-data">

            <input type="file" name="file" class="form-control mb-3" required />

            <button class="btn btn-primary w-100">Analyze Resume</button>



        </form>
       

        @if (ViewBag.Msg != null)
        {
            <p class="text-danger text-center mt-2">@ViewBag.Msg</p>
        }

        <div class="text-center mt-3">
            <button onclick="history.back()" class="btn btn-secondary px-4">
                Back
            </button>
        </div>

    </div>
    
</div>