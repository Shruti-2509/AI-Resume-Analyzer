@model List<ResumeAnalyzer.Models.Job>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4">All Jobs</h2>

<table class="table table-bordered table-striped">
    <tr class="table-primary">
        <th>ID</th>
        <th>Title</th>
        <th>Category</th>
        <th>Skills</th>
    </tr>

    @foreach (var job in Model)
    {
        <tr>
            <td>@job.job_id</td>
            <td>@job.job_title</td>
            <td>@job.category</td>
            <td>@job.required_skills</td>
        </tr>
    }

</table>