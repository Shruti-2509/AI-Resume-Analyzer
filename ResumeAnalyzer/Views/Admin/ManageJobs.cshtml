@model List<ResumeAnalyzer.Models.Job>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4">Manage Jobs</h2>

<!-- ADD JOB -->
<div class="card p-4 mb-4">
    <form method="post" action="/Admin/AddJobManage">
        <input name="job_title" class="form-control mb-2" placeholder="Job Title" required />
        <input name="category" class="form-control mb-2" placeholder="Category" required />
        <textarea name="required_skills" class="form-control mb-2" placeholder="Skills"></textarea>

        <button class="btn btn-primary w-100">Add Job</button>
    </form>
</div>

<!-- SEARCH -->
<form method="get" class="mb-3">
    <input name="search" class="form-control mb-2" placeholder="Search Job Title" />
    <input name="category" class="form-control mb-2" placeholder="Filter Category" />
    <button class="btn btn-info w-100">Search</button>
</form>

<!-- TABLE -->
<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Category</th>
        <th>Skills</th>
        <th>Action</th>
    </tr>

    @foreach (var job in Model)
    {
        <tr>
            <td>@job.job_id</td>
            <td>@job.job_title</td>
            <td>@job.category</td>
            <td>@job.required_skills</td>
            <td>
                <a href="/Admin/DeleteJob/@job.job_id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
</table>
<!-- 🔙 BACK BUTTON -->
<div class="text-center mt-4 mb-4">
    <a href="/Admin/Dashboard" class="btn btn-secondary">
        Back
    </a>
</div>